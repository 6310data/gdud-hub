{
  "name": "gdud-hub",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@gdud/web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @gdud/db generate",
    "db:migrate": "pnpm --filter @gdud/db migrate",
    "db:bootstrap-admin": "pnpm --filter @gdud/db bootstrap-admin"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "~7.0.2"
  }
}
